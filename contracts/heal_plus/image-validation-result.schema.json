{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://healplus.local/contracts/image-validation-result.schema.json",
  "title": "Technical image validation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "image_id",
    "status",
    "reasons"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "image_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "status": {
      "enum": [
        "accepted",
        "rejected",
        "indeterminate"
      ]
    },
    "reasons": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    }
  }
}
