# -----------------------------------------------------------------------------
# Shared environment contract for local development
# -----------------------------------------------------------------------------

# Flask / local API
FLASK_ENV=development
CLINICAL_API_REQUIRE_AUTH=1
CLINICAL_API_ALLOWED_ORIGIN=http://localhost:3000
CLINICAL_API_URL=http://localhost:5000/api/v1
REDISUS_ALLOW_LEGACY_UNSCOPED_PATIENT_ACCESS=0
REDISUS_MAX_UPLOAD_BYTES=10485760
REDISUS_MAX_IMAGE_MEGAPIXELS=12
REDISUS_RATE_LIMIT_WINDOW_SECONDS=60
REDISUS_RATE_LIMIT_ANALYZE=20
REDISUS_RATE_LIMIT_WOUND_ANALYSIS=20
REDISUS_RATE_LIMIT_WOUND_ANALYSIS_READ=120
REDISUS_RATE_LIMIT_UPLOAD=30
REDISUS_RATE_LIMIT_REPORT=10
REDISUS_RATE_LIMIT_CHAT=60
REDISUS_RATE_LIMIT_LABEL=20

# Frontend public endpoints
NEXT_PUBLIC_CLINICAL_API_URL=http://localhost:3000/api/clinical
NEXT_PUBLIC_HEAL_AI_API_URL=http://localhost:5000/api/v1
VITE_CLINICAL_API_URL=http://localhost:5000/api/v1

# Firebase Web SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG=false

# Firebase Admin / backend
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_STORAGE_BUCKET=

# Generative AI
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=
GOOGLE_GENAI_API_KEY=

# Segmentacao binaria experimental de feridas (checkpoint local fora do Git).
# O modelo CO2Wounds-V2 e restrito a pesquisa nao comercial e nunca deve ser
# habilitado silenciosamente em producao ou para decisao clinica autonoma.
HEAL_ENABLE_EXPERIMENTAL_WOUND_SEGMENTER=0
HEAL_WOUND_SEGMENTATION_CHECKPOINT=models/wound_segmentation/best_small_unet.pt
HEAL_ALLOW_NONCOMMERCIAL_RESEARCH_MODEL=0
