{
  "name": "healplus-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "tsc --noEmit",
    "doctor": "node scripts/check-environment.mjs",
    "docs:check": "node scripts/check-markdown-links.mjs --boundary ../../..",
    "docs:data:check": "node scripts/data-dictionary.mjs --check",
    "docs:data:generate": "node scripts/data-dictionary.mjs --write",
    "docs:data:refresh": "node scripts/data-dictionary.mjs --refresh",
    "test": "npm run test:unit && npm run test:tooling",
    "test:unit": "vitest run src/tests/unit src/tests/components",
    "test:tooling": "node --test scripts/tests/*.test.mjs",
    "test:backup-restore": "node scripts/backup-restore-drill.mjs --confirm-local-reset",
    "test:coverage": "vitest run --coverage src/tests/unit src/tests/components",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@hookform/resolvers": "^3.10.0",
    "@supabase/supabase-js": "2.110.0",
    "date-fns": "^3.6.0",
    "framer-motion": "^13.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.53.2",
    "react-router": "^8.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
